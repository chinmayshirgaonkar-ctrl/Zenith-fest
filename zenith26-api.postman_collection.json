      "name": "1. GET All Events (with category and search params)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/events?category=Technical&search=Sprint",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "events"
          ],
          "query": [
            {
              "key": "category",
              "value": "Technical",
              "description": "Optional category filter"
            },
            {
              "key": "search",
              "value": "Sprint",
              "description": "Optional title search filter"
            }
          ]
        },
        "description": "Retrieves the list of events matching query parameters, with live computed available_seats."
      },
      "response": [
        {
          "name": "200 Success Response",
          "originalRequest": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/events?category=Technical&search=Sprint",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events"],
              "query": [
                {"key": "category", "value": "Technical"},
                {"key": "search", "value": "Sprint"}
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "body": "[\n  {\n    \"id\": 1,\n    \"title\": \"Code Sprint 2.0\",\n    \"category\": \"Technical\",\n    \"description\": \"Fast-paced competitive programming contest solving algorithmic challenges under time pressure.\",\n    \"event_date\": \"2026-11-14\",\n    \"event_time\": \"10:00 AM\",\n    \"venue\": \"Main Auditorium\",\n    \"capacity\": 100,\n    \"fee\": 0,\n    \"icon\": \"💻\",\n    \"available_seats\": 100\n  }\n]"
        }
